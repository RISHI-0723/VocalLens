# VocalLens environment template.
#
# The core pipeline and dashboard need NO secrets or network credentials.
# Optional overrides below; copy to `.env` only if you need them.

# Override config paths (defaults: configs/analysis.yaml, configs/scoring.yaml)
# VOCALLENS_ANALYSIS_CONFIG=configs/analysis.yaml
# VOCALLENS_SCORING_CONFIG=configs/scoring.yaml

# Optional: Hugging Face token ONLY if you install the optional WhisperX path
# (requirements-align.txt) and use gated alignment models. Never commit a real token.
# HF_TOKEN=
