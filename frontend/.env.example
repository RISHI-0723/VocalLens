# Frontend configuration (no secrets — anything with the VITE_ prefix is
# embedded in the public bundle and visible to users).
#
# Base origin of the FastAPI backend. Leave EMPTY in local dev to use the Vite
# proxy (/api -> http://localhost:8000). In production (Vercel) set this to the
# deployed backend origin, e.g. the Render service URL. No trailing slash.
VITE_API_BASE=

# Example production value (set this in the Vercel project's Environment
# Variables, not committed here):
# VITE_API_BASE=https://vocallens-api.onrender.com
